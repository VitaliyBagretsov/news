{
  "name": "back-news",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "type": "module",
  "imports": {
    "#auth": {
      "types": "./src/auth/index.ts",
      "default": "./dist/auth/index.js"
    },
    "#common": {
      "types": "./src/common/index.ts",
      "default": "./dist/common/index.js"
    },
    "#exceptions/*": {
      "types": "./src/exceptions/*.ts",
      "default": "./dist/exceptions/*.js"
    },
    "#media": {
      "types": "./src/media/index.ts",
      "default": "./dist/media/index.js"
    },
    "#news": {
      "types": "./src/news/index.ts",
      "default": "./dist/news/index.js"
    },
    "#users": {
      "types": "./src/users/index.ts",
      "default": "./dist/users/index.js"
    }
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:ci": "npm test -- --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/typeorm": "^10.0.2",
    "cheerio": "^1.0.0-rc.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "connect-pg-simple": "^10.0.0",
    "crypto": "^1.0.1",
    "express-session": "^1.19.0",
    "jsdom": "^23.2.0",
    "mysql": "^2.18.1",
    "openid-client": "^6.8.7",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "tress": "^1.1.4",
    "typeorm": "^0.3.20",
    "website-scraper": "^5.3.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.2",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^22.20.1",
    "@types/supertest": "^2.0.12",
    "@types/tress": "^1.0.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^#auth$": "<rootDir>/auth/index",
      "^#(common|media|news|users)$": "<rootDir>/$1/index",
      "^#exceptions/(.*)$": "<rootDir>/exceptions/$1"
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
