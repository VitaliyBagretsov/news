{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^#(app\\.service|task\\.service)$": "<rootDir>/../src/$1",
    "^#(auth|common|config|constants|dto|entities|exceptions|media|news|users|util)/(.*)$": "<rootDir>/../src/$1/$2",
    "^#(decorators|types)$": "<rootDir>/../src/$1/index"
  },
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true
      }
    ]
  }
}
