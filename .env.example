COMPOSE_PROJECT_NAME=news

POSTGRES_VERSION=18.6-alpine3.24
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=news_db
POSTGRES_USER=news_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=3000
TYPEORM_SYNCHRONIZE=true

PARSER_MAX_ARTICLES_PER_RUN=20
PARSER_RUN_ON_START=true

SESSION_SECRET=replace_with_at_least_32_random_characters
SESSION_COOKIE_SECURE=false

KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/news-realm
KEYCLOAK_CLIENT_ID=news-client
KEYCLOAK_CLIENT_SECRET=change_me
